#: lib/wfVersionCheckController.php:70
msgid "<strong>WARNING: </strong> Your site is using a PHP version (%1$s) that will no longer be supported by Wordfence in an upcoming release and needs to be updated. We recommend using the newest version of PHP available but will currently support PHP versions as old as %2$s. Version checks are run regularly, so if you have successfully updated, you can dismiss this notice or check that the update has taken effect later."
msgstr "<strong>УПОЗОРЕЊЕ: </strong> Ваш сајт користи PHP издање (%1$s) које Wordfence неће подржавати у предстојећем издању и мора да се ажурира. Препоручујемо коришћење најновијег доступног издања PHP-а, али тренутно подржавамо PHP издања почевши од %2$s. Провере издања се редовно покрећу, па ако сте успешно ажурирали, можете одбацити ово обавештење или касније проверити да ли је ажурирање ступило на снагу."

#: lib/wfJavascriptBridge.php:945
msgid "The <code>auto_prepend_file</code> setting has been successfully removed from <code>.htaccess</code> and <code>.user.ini</code>. Once this change takes effect, Extended Protection Mode will be disabled."
msgstr "Подешавање <code>auto_prepend_file</code> успешно је уклоњено из <code>.htaccess</code> и <code>.user.ini</code>. Када ова измена ступи на снагу, режим проширене заштите биће искључен."

#: lib/wordfenceClass.php:7402
msgid "<strong>ERROR</strong>: Incorrect username or password."
msgstr "<strong>ГРЕШКА</strong>: нетачно корисничко име или лозинка."

#. translators: WordPress username.
#: lib/wordfenceClass.php:3226
msgid "<strong>Cellphone Sign-in Required</strong>: Cellphone Sign-in is required for all administrator accounts. Please contact the site administrator to enable it for your account."
msgstr "<strong>Потребна је пријава мобилним телефоном</strong>: пријава мобилним телефоном обавезна је за све администраторске налоге. Обратите се администратору сајта да је укључи за ваш налог."

#: lib/wordfenceClass.php:3179
msgid "<strong>CHECK YOUR PHONE</strong>: A code has been sent to your phone and will arrive within 30 seconds. Please sign in again and add a space and the code to the end of your password (e.g., <code>wfABCD</code>)."
msgstr "<strong>ПРОВЕРИТЕ ТЕЛЕФОН</strong>: кôд је послат на ваш телефон и стићи ће у року од 30 секунди. Пријавите се поново и додајте размак и кôд на крај лозинке (нпр. <code>wfABCD</code>)."

#. translators: 1. Reset password URL. 2. Support URL.
#: lib/wordfenceClass.php:3217 lib/wordfenceClass.php:3253
msgid "<strong>INSECURE PASSWORD:</strong> Your login attempt has been blocked because the password you are using exists on lists of passwords leaked in data breaches. Attackers use such lists to break into sites and install malicious code. Please <a href=\"%1$s\">reset your password</a> to reactivate your account. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Learn More<span style=\"font-size:0;\"> (opens in new tab)</span></a>"
msgstr "<strong>НЕБЕЗБЕДНА ЛОЗИНКА:</strong> ваш покушај пријаве је блокиран јер се лозинка коју користите налази на списковима лозинки које су процуреле у цурењима података. Нападачи користе такве спискове да провале у сајтове и поставе злонамерни кôд. <a href=\"%1$s\">Промените лозинку</a> да бисте поново укључили налог. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Сазнајте више<span style=\"font-size:0;\"> (отвара се у новом језичку)</span></a>"

#. translators: 1. Reset password URL. 2. Support URL.
#: lib/wordfenceClass.php:3200 lib/wordfenceClass.php:3236
msgid "<strong>WARNING: </strong>Your login has been allowed because you have previously logged in from the same IP, but you will be blocked if your IP changes. The password you are using exists on lists of passwords leaked in data breaches. Attackers use such lists to break into sites and install malicious code. Please <a href=\"%1$s\">change your password</a>. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Learn More<span class=\"screen-reader-text\"> (opens in new tab)</span></a>"
msgstr "<strong>УПОЗОРЕЊЕ: </strong>ваша пријава је дозвољена јер сте се раније пријављивали са исте IP адресе, али бићете блокирани ако се ваша IP адреса промени. Лозинка коју користите налази се на списковима лозинки које су процуреле у цурењима података. Нападачи користе такве спискове да провале у сајтове и поставе злонамерни кôд. <a href=\"%1$s\">Промените лозинку</a>. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Сазнајте више<span class=\"screen-reader-text\"> (отвара се у новом језичку)</span></a>"

#: lib/wordfenceClass.php:3122
msgid "<strong>CHECK YOUR PHONE</strong>: A code has been sent to your phone and will arrive within 30 seconds. Please sign in again and add a space, the letters <code>wf</code>, and the code to the end of your password (e.g., <code>wf123456</code>)."
msgstr "<strong>ПРОВЕРИТЕ ТЕЛЕФОН</strong>: кôд је послат на ваш телефон и стићи ће у року од 30 секунди. Пријавите се поново и додајте размак, слова <code>wf</code> и кôд на крај лозинке (нпр. <code>wf123456</code>)."

#: lib/wordfenceClass.php:3117 lib/wordfenceClass.php:3174
msgid "<strong>CHECK YOUR PHONE</strong>: A code has been sent to your phone and will arrive within 30 seconds. Enter it below to sign in."
msgstr "<strong>ПРОВЕРИТЕ ТЕЛЕФОН</strong>: кôд је послат на ваш телефон и стићи ће у року од 30 секунди. Унесите га испод да бисте се пријавили."

#: lib/wordfenceClass.php:3083
msgid "<strong>CODE REQUIRED</strong>: Please check your authenticator app for the current code. Please sign in again and add a space, the letters <code>wf</code>, and the code to the end of your password (e.g., <code>wf123456</code>)."
msgstr "<strong>ПОТРЕБАН ЈЕ КÔД</strong>: проверите тренутни кôд у апликацији за потврђивање идентитета. Пријавите се поново и додајте размак, слова <code>wf</code> и кôд на крај лозинке (нпр. <code>wf123456</code>)."

#: lib/wordfenceClass.php:3078
msgid "<strong>CODE REQUIRED</strong>: Please check your authenticator app for the current code. Enter it below to sign in."
msgstr "<strong>ПОТРЕБАН ЈЕ КÔД</strong>: проверите тренутни кôд у апликацији за потврђивање идентитета. Унесите га испод да бисте се пријавили."

#: lib/wordfenceClass.php:3027
msgid "<strong>INVALID CODE</strong>: You need to enter your password and the code we sent to your phone. The code should start with 'wf' and should be four characters (e.g., wfAB12)."
msgstr "<strong>НЕИСПРАВАН КÔД</strong>: морате да унесете лозинку и кôд који смо послали на ваш телефон. Кôд треба да почиње са „wf“ и да има четири знака (нпр. wfAB12)."

#: lib/wordfenceClass.php:3004
msgid "<strong>CODE EXPIRED. CHECK YOUR PHONE:</strong> The code you entered has expired. Codes are only valid for 30 minutes for security reasons. We have sent you a new code. Please sign in using your username, password, and the new code we sent you."
msgstr "<strong>КÔД ЈЕ ИСТЕКАО. ПРОВЕРИТЕ ТЕЛЕФОН:</strong> кôд који сте унели је истекао. Кодови важе само 30 минута из безбедносних разлога. Послали смо вам нови кôд. Пријавите се помоћу корисничког имена, лозинке и новог кода који смо вам послали."

#: lib/wordfenceClass.php:2958
msgid "<strong>INVALID CODE</strong>: You need to enter the code generated sent to your phone. The code should be a six digit number (e.g., 123456)."
msgstr "<strong>НЕИСПРАВАН КÔД</strong>: морате да унесете кôд послат на ваш телефон. Кôд треба да буде шестоцифрени број (нпр. 123456)."

#: lib/wordfenceClass.php:2954
msgid "<strong>INVALID CODE</strong>: You need to enter the code generated by your authenticator app. The code should be a six digit number (e.g., 123456)."
msgstr "<strong>НЕИСПРАВАН КÔД</strong>: морате да унесете кôд који је направила ваша апликација за потврђивање идентитета. Кôд треба да буде шестоцифрени број (нпр. 123456)."

#: lib/wordfenceClass.php:2944 lib/wordfenceClass.php:2995
#: lib/wordfenceClass.php:3018
msgid "<strong>AUTHENTICATION FAILURE</strong>: A temporary failure was encountered while trying to log in. Please try again."
msgstr "<strong>НЕУСПЕХ ПОТВРЂИВАЊА ИДЕНТИТЕТА</strong>: дошло је до привременог неуспеха при покушају пријаве. Покушајте поново."

#: lib/wordfenceClass.php:2937
msgid "<strong>INVALID CODE</strong>: Please sign in again and add a space, the letters <code>wf</code>, and the code sent to your phone to the end of your password (e.g., <code>wf123456</code>)."
msgstr "<strong>НЕИСПРАВАН КÔД</strong>: пријавите се поново и додајте размак, слова <code>wf</code> и кôд послат на ваш телефон на крај лозинке (нпр. <code>wf123456</code>)."

#: lib/wordfenceClass.php:2933
msgid "<strong>INVALID CODE</strong>: Please sign in again and add a space, the letters <code>wf</code>, and the code from your authenticator app to the end of your password (e.g., <code>wf123456</code>)."
msgstr "<strong>НЕИСПРАВАН КÔД</strong>: пријавите се поново и додајте размак, слова <code>wf</code> и кôд из апликације за потврђивање идентитета на крај лозинке (нпр. <code>wf123456</code>)."

#. translators: 1. WordPress admin panel URL. 2. Support URL.
#: lib/wordfenceClass.php:2909 lib/wordfenceClass.php:3045
msgid "<strong>WARNING: </strong>The password you are using exists on lists of passwords leaked in data breaches. Attackers use such lists to break into sites and install malicious code. Please <a href=\"%1$s\">change your password</a>. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Learn More<span class=\"screen-reader-text\"> (opens in new tab)</span></a>"
msgstr "<strong>УПОЗОРЕЊЕ: </strong>лозинка коју користите налази се на списковима лозинки које су процуреле у цурењима података. Нападачи користе такве спискове да провале у сајтове и поставе злонамерни кôд. <a href=\"%1$s\">Промените лозинку</a>. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Сазнајте више<span class=\"screen-reader-text\"> (отвара се у новом језичку)</span></a>"

#. translators: 1. WordPress username. 2. Password reset URL.
#: lib/wordfenceClass.php:2890 lib/wordfenceClass.php:3451
msgid "<strong>ERROR</strong>: The username or password you entered is incorrect. <a href=\"%2$s\" title=\"Password Lost and Found\">Lost your password</a>?"
msgstr "<strong>ГРЕШКА</strong>: корисничко име или лозинка које сте унели нису тачни. <a href=\"%2$s\" title=\"Изгубљена лозинка\">Изгубили сте лозинку</a>?"

#: lib/wordfenceClass.php:2883
msgid "<strong>VERIFICATION FAILED</strong>: Two-factor authentication verification failed. Please try again."
msgstr "<strong>ПРОВЕРА НИЈЕ УСПЕЛА</strong>: провера двофакторске потврде идентитета није успела. Покушајте поново."

#: lib/wordfenceClass.php:2680
msgid "<strong>ERROR</strong>: You can't register using that username"
msgstr "<strong>ГРЕШКА</strong>: не можете да се региструјете са тим корисничким именом"

