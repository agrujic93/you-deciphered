lid.":["\u041e\u0431\u043b\u0438\u043a \u0434\u0430\u0442\u0443\u043c\u0430 \u0458\u0435 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u0430\u043d."],"Time zone is invalid.":["\u0412\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0430 \u0437\u043e\u043d\u0430 \u0458\u0435 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0430."],"Date format is required.":["\u041e\u0431\u043b\u0438\u043a \u0434\u0430\u0442\u0443\u043c\u0430 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d."],"A non-UTC time zone is required.":["\u041f\u043e\u0442\u0440\u0435\u0431\u043d\u0430 \u0458\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0430 \u0437\u043e\u043d\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0458\u0435 UTC."],"Currency symbol is invalid.":["\u0421\u0438\u043c\u0431\u043e\u043b \u0432\u0430\u043b\u0443\u0442\u0435 \u0458\u0435 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u0430\u043d."],"Currency symbol is required.":["\u0421\u0438\u043c\u0431\u043e\u043b \u0432\u0430\u043b\u0443\u0442\u0435 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d."],"Let's get your events with the correct basic settings.":["\u041f\u043e\u0434\u0435\u0441\u0438\u043c\u043e \u0432\u0430\u0448\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435 \u0441\u0430 \u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0438\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0438\u043c\u0430."],"Please select your time zone.":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043e\u0458\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0443 \u0437\u043e\u043d\u0443."],"Please select your time zone as UTC offsets are not supported.":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043e\u0458\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0443 \u0437\u043e\u043d\u0443 \u0458\u0435\u0440 UTC \u043f\u043e\u043c\u0430\u0446\u0438 \u043d\u0438\u0441\u0443 \u043f\u043e\u0