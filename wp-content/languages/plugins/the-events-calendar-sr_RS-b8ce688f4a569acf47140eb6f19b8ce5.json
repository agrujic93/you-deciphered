\u0418\u0437\u0430\u0431\u0435\u0440\u0438 \u0441\u0432\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0435"],"Skip step":["\u041f\u0440\u0435\u0441\u043a\u043e\u0447\u0438 \u043a\u043e\u0440\u0430\u043a"],"Continue":["\u041d\u0430\u0441\u0442\u0430\u0432\u0438"],"Congratulations on installing the best event management solution for WordPress. Let's tailor your experience to your needs.":["\u0427\u0435\u0441\u0442\u0438\u0442\u0430\u043c\u043e \u043d\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0443 \u043d\u0430\u0458\u0431\u043e\u0459\u0435\u0433 \u0440\u0435\u0448\u0435\u045a\u0430 \u0437\u0430 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0438\u043c\u0430 \u0437\u0430 \u0412\u043e\u0440\u0434\u043f\u0440\u0435\u0441. \u041f\u0440\u0438\u043b\u0430\u0433\u043e\u0434\u0438\u043c\u043e \u0432\u0430\u0448\u0435 \u0438\u0441\u043a\u0443\u0441\u0442\u0432\u043e \u0432\u0430\u0448\u0438\u043c \u043f\u043e\u0442\u0440\u0435\u0431\u0430\u043c\u0430."],"Yes, I\u2019d like to share basic information and have access to the TEC chatbot.":["\u0414\u0430, \u0436\u0435\u043b\u0438\u043c \u0434\u0430 \u0434\u0435\u043b\u0438\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0438 \u0438\u043c\u0430\u043c \u043f\u0440\u0438\u0441\u0442\u0443\u043f TEC \u0447\u0435\u0442\u0431\u043e\u0442\u0443."],"What permissions are being granted?":["\u041a\u043e\u0458\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u0435 \u0441\u0435 \u0434\u043e\u0434\u0435\u0459\u0443\u0458\u0443?"],"Skip guided setup":["\u041f\u0440\u0435\u0441\u043a\u043e\u0447\u0438 \u0432\u043e\u0452\u0435\u043d\u043e \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0435"],"Set up my calendar":["\u041f\u043e\u0434\u0435\u0441\u0438 \u043c\u043e\u0458 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440"],"Date format":["\u041e\u0431\u043b\u0438\u043a \u0434\u0430\u0442\u0443\u043c\u0430"],"Address":["\u0410\u0434\u04