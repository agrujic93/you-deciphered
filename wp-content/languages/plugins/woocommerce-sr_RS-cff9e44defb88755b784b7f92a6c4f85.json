0434\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043b\u0438 \u043f\u043e\u0440\u0443\u045f\u0431\u0438\u043d\u0435, \u0438\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u043e\u0440\u0443\u045f\u0431\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0437\u0430\u0445\u0442\u0435\u0432\u0430\u0458\u0443 \u0434\u043e\u0434\u0430\u0442\u043d\u0438 \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u0443 \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0438\u043c\u0430."],"Manage all orders":["\u0423\u043f\u0440\u0430\u0432\u0459\u0430\u0458\u0442\u0435 \u0441\u0432\u0438\u043c \u043f\u043e\u0440\u0443\u045f\u0431\u0438\u043d\u0430\u043c\u0430."],"Your inbox is empty":["\u0412\u0430\u0448\u0435 \u043f\u0440\u0438\u0458\u0435\u043c\u043d\u043e \u0441\u0430\u043d\u0434\u0443\u0447\u0435 \u0458\u0435 \u043f\u0440\u0430\u0437\u043d\u043e."],"Personalize my store":["\u041f\u0440\u0438\u043b\u0430\u0433\u043e\u0434\u0438\u0442\u0435 \u043c\u043e\u0458\u0443 \u043f\u0440\u043e\u0434\u0430\u0432\u043d\u0438\u0446\u0443"],"Display stats":["\u041f\u0440\u0438\u043a\u0430\u0437 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435"],"Select a default date range. When no range is selected, reports will be viewed by the default date range.":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434. \u041a\u0430\u0434\u0430 \u043d\u0438\u0458\u0435 \u0438\u0437\u0430\u0431\u0440\u0430\u043d \u043d\u0438\u0458\u0435\u0434\u0430\u043d \u043e\u043f\u0441\u0435\u0433, \u0438\u0437\u0432\u0435\u0448\u0442\u0430\u0458\u0438 \u045b\u0435 \u0441\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0438\u0432\u0430\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0437\u0430\u0434\u0430\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u043e\u043c \u0440\u0430\u0441\u043f\u043e\u043d\u0443."],"in stock":["\u043d\u0430 \u0437\u0430\u043b\u0438\u0445\u0430\u043c\u