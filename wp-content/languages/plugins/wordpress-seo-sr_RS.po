#. translators: %s expands to Yoast SEO
#: src/abilities/user-interface/ability-categories-integration.php:45
msgid "Abilities for %s data and operations."
msgstr "Могућности за податке и радње %s."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:126
msgid "Whether search engines should be told not to show a snippet of this post in the search results."
msgstr "Да ли претраживачима треба рећи да не приказују исечак овог чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:122
msgid "Whether search engines should be told not to show a cached copy of this post."
msgstr "Да ли претраживачима треба рећи да не приказују кеширану копију овог чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:118
msgid "Whether search engines should be told not to index the images on this post."
msgstr "Да ли претраживачима треба рећи да не индексирају слике овог чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:114
msgid "Whether search engines should be told not to follow the links on this post."
msgstr "Да ли претраживачима треба рећи да не прате везе овог чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:106
msgid "Whether the post is marked as cornerstone content."
msgstr "Да ли је чланак означен као темељни садржај."

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:158
msgid "The Schema.org article type stored for the post. Null means no override is set and the default for the post type applies."
msgstr "Schema.org врста чланка сачувана за чланак. Null значи да замена није подешена и примењује се подразумевана вредност за врсту чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:102
msgid "The custom canonical URL for the post. Use null or an empty string to remove it and fall back to the default canonical."
msgstr "Произвољна канонска адреса за чланак. Користите null или празну ниску да бисте је уклонили и вратили се на подразумевану канонску адресу."

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:154
msgid "The Schema.org page type stored for the post. Null means no override is set and the default for the post type applies."
msgstr "Schema.org врста странице сачувана за чланак. Null значи да замена није подешена и примењује се подразумевана вредност за врсту чланка."

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:133
msgid "The canonical URL as output on the front end: the custom value when set, otherwise the permalink of the post. Null when nothing is output."
msgstr "Канонска адреса како се исписује на предњем делу: произвољна вредност када је подешена, у супротном стална веза чланка. Null када се ништа не исписује."

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:129
msgid "The custom canonical URL as stored for the post. Null when no custom value is set; the rendered companion field carries what is actually output."
msgstr "Произвољна канонска адреса како је сачувана за чланак. Null када произвољна вредност није подешена; пратеће приказано поље носи оно што се заиста исписује."

#. translators: %s expands to the name of the SEO field, e.g. "SEO title".
#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:108
msgid "The custom %s as stored for the post, which may contain unexpanded replacement variables. Null when no custom value is set; the rendered companion field carries what is actually output."
msgstr "Произвољни %s како је сачуван за чланак, који може да садржи неразвијене променљиве замене. Null када произвољна вредност није подешена; пратеће приказано поље носи оно што се заиста исписује."

#: src/bulk-editor/user-interface/posts-overview-bulk-actions-integration.php:110
msgid "Bulk edit"
msgstr "Групно уређивање"

