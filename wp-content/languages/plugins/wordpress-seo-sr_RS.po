#. underlying error message.
#: src/exceptions/indexable/indexing-failed-exception.php:53
msgid "Yoast SEO could not build the indexable for %1$s: %2$s"
msgstr "Yoast SEO није могао да направи индексабилни елемент за %1$s: %2$s"

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:162
msgid "inclusive language analysis"
msgstr "анализа инклузивног језика"

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:161
msgid "readability analysis"
msgstr "анализа читљивости"

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:146
#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:147
msgid "Open Graph description"
msgstr "Open Graph опис"

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:144
#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:145
msgid "Open Graph title"
msgstr "Open Graph наслов"

#. translators: %s expands to the name of the SEO field, e.g. "SEO title".
#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:96
msgid "The %s as output on the front end: the global default template applied when no custom value is set, with replacement variables expanded. Null when nothing is output."
msgstr "%s онако како се исписује на сајту: глобални подразумевани шаблон који се примењује када није постављена произвољна вредност, са развијеним променљивама замене. Null када се ништа не исписује."

#. translators: %s expands to the name of the analysis, e.g. "SEO analysis".
#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:84
msgid "The result of the %s that ran on the post when it was last saved."
msgstr "Резултат %s која је покренута на чланку када је последњи пут сачуван."

#: src/abilities/user-interface/abilities/abstract-post-seo-data-ability.php:138
msgid "Whether search engines are told not to index this post. true means noindex (the post is excluded from search results); false means the post is forced to be indexed; null means no setting is stored and the post-type default applies."
msgstr "Да ли је претраживачима речено да не индексирају овај чланак. true значи noindex (чланак је искључен из резултата претраге); false значи да је индексирање чланка наметнуто; null значи да подешавање није сачувано и важи подразумевана вредност за врсту чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:110
msgid "Whether search engines should be told not to index this post. true sets noindex (the post is excluded from search results); false forces the post to be indexed; null clears the setting and falls back to the post-type default."
msgstr "Да ли претраживачима треба рећи да не индексирају овај чланак. true поставља noindex (чланак је искључен из резултата претраге); false намеће индексирање чланка; null уклања подешавање и враћа на подразумевану вредност за врсту чланка."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:134
msgid "The Schema.org article type for the post. Must be one of the supported article types. Use null or an empty string to clear it and fall back to the default."
msgstr "Schema.org врста чланка за чланак. Мора бити једна од подржаних врста чланака. Користите null или празну ниску да бисте је очистили и вратили се на подразумевану."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:130
msgid "The Schema.org page type for the post. Must be one of the supported page types. Use null or an empty string to clear it and fall back to the default."
msgstr "Schema.org врста странице за чланак. Мора бити једна од подржаних врста страница. Користите null или празну ниску да бисте је очистили и вратили се на подразумевану."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:98
msgid "The permalink (URL) of the post to update."
msgstr "Трајна веза (URL) чланка који се ажурира."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:93
msgid "The ID of the post to update."
msgstr "ID чланка који се ажурира."

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:107
msgid "The page of title-search results to return, 1-based and defaulting to 1. Matches are ordered most recently modified first, so request a later page to reach older matches. An empty result means there are no further pages. Only applies to a title search."
msgstr "Страница резултата претраге по наслову која се враћа, почиње од 1 и подразумевано је 1. Подударања су поређана од најскорије измењених, па затражите каснију страницу да бисте дошли до старијих подударања. Празан резултат значи да нема више страница. Важи само за претрагу по наслову."

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:103
msgid "Keywords to search for in post titles. Provide a comma-separated list to search for several titles at once; each value is matched as a whole phrase against the post title, and a post matching any value is returned. At most 10 phrases are used per request; any beyond the first 10 are ignored. Results are paginated to 10 entities per page; see the page parameter."
msgstr "Кључне речи за претрагу у насловима чланака. Наведите списак раздвојен зарезима да бисте претражили више наслова одједном; свака вредност се упоређује као цела фраза са насловом чланка и враћа се чланак који се подудара са било којом вредношћу. По захтеву се користи највише 10 фраза; све после првих 10 се занемарују. Резултати су подељени на странице од по 10 ентитета; погледајте параметар page."

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:99
msgid "The permalink (URL) of the post to retrieve."
msgstr "Трајна веза (URL) чланка који се преузима."

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:94
msgid "The ID of the post to retrieve."
msgstr "ID чланка који се преузима."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:60
msgid "Update the SEO data for a single post. Identify the post by post_id or by permalink (URL). Only the fields you provide are changed; a provided empty value clears that field. Only posts the current user is allowed to edit can be updated."
msgstr "Ажурирајте SEO податке за један чланак. Одредите чланак помоћу post_id или трајне везе (URL). Мењају се само поља која наведете; наведена празна вредност брише то поље. Могу се ажурирати само чланци које тренутни корисник сме да уређује."

#: src/abilities/user-interface/abilities/update-post-seo-data-ability.php:59
msgid "Update Post SEO Data"
msgstr "Ажурирај SEO податке чланка"

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:59
msgid "Get the SEO data for a post. Identify the post by post_id, by permalink (URL), or by title keywords; the title may be a comma-separated list and returns the SEO data for every post matching any of the values, paginated most recently modified first (use the page parameter to reach older matches). At least one identifier is required. Only posts the current user is allowed to edit are returned."
msgstr "Преузмите SEO податке за чланак. Одредите чланак помоћу post_id, трајне везе (URL) или кључних речи наслова; наслов може бити списак раздвојен зарезима и враћа SEO податке за сваки чланак који се подудара са било којом вредношћу, подељено на странице од најскорије измењених (користите параметар page да бисте дошли до старијих подударања). Потребан је бар један идентификатор. Враћају се само чланци које тренутни корисник сме да уређује."

#: src/abilities/user-interface/abilities/get-post-seo-data-ability.php:58
msgid "Get Post SEO Data"
msgstr "Преузми SEO податке чланка"

#: src/abilities/infrastructure/post-identifier-resolver.php:185
msgid "No post could be found for the given identifier."
msgstr "Није пронађен ниједан чланак за дати идентификатор."

#: src/abilities/infrastructure/post-identifier-resolver.php:95
msgid "Provide a post_id, a permalink, or title keywords to identify the post."
msgstr "Наведите post_id, трајну везу или кључне речи наслова да бисте одредили чланак."

#: src/abilities/infrastructure/post-identifier-resolver.php:59
msgid "Provide a post_id or a permalink to identify the post."
msgstr "Наведите post_id или трајну везу да бисте одредили чланак."

#: src/abilities/infrastructure/post-access-checker.php:44
msgid "Sorry, you are not allowed to edit this post."
msgstr "Жао нам је, није вам дозвољено да уређујете овај чланак."

#: src/abilities/application/post-seo-data-updater.php:119
msgid "The post SEO data was saved but the indexable could not be rebuilt."
msgstr "SEO подаци чланка су сачувани, али индексабилни елемент није могао поново да се направи."

#: src/myyoast-client/user-interface/myyoast-client-integration.php:76
msgid "Every 90 days"
msgstr "Сваких 90 дана"

#: src/abilities/user-interface/abilities/abstract-score-ability.php:198
msgid "The post title."
msgstr "Наслов чланка."

#: src/abilities/user-interface/abilities/abstract-score-ability.php:203
msgid "The score slug."
msgstr "Подложак резултата"

#: src/abilities/user-interface/abilities/abstract-score-ability.php:207
msgid "A human-readable label for the score."
msgstr "Ознака резултата која је разумљива људима."

#: src/abilities/user-interface/abilities/get-seo-scores-ability.php:38
msgid "Get SEO Scores"
msgstr "Преузми SEO резултате"

#: src/abilities/user-interface/abilities/get-readability-scores-ability.php:38
msgid "Get Readability Scores"
msgstr "Преузми резултате читљивости"

#: src/abilities/user-interface/abilities/get-inclusive-language-scores-ability.php:38
msgid "Get Inclusive Language Scores"
msgstr "Преузми резултате за инклузиван језик"

#: src/abilities/user-interface/abilities/get-inclusive-language-scores-ability.php:47
msgid "Get the inclusive language scores for the most recently modified posts."
msgstr "Преузми оцене инклузивног језика за најскорије измењене чланке."

#: src/abilities/user-interface/abilities/get-readability-scores-ability.php:47
msgid "Get the readability scores for the most recently modified posts."
msgstr "Преузми оцене читљивости за најскорије измењене чланке."

#: src/abilities/user-interface/abilities/abstract-score-ability.php:140
msgid "The number of recently modified posts to retrieve scores for. Defaults to 10."
msgstr "Број недавно измењених чланака за које се преузимају оцене. Подразумевано је 10."

#: src/abilities/user-interface/abilities/get-seo-scores-ability.php:47
msgid "Get the SEO scores for the most recently modified posts."
msgstr "Преузми SEO оцене за најскорије измењене чланке."

#: src/abilities/user-interface/abilities/get-seo-scores-ability.php:70
msgid "The focus keyphrase for the post, or null if not set."
msgstr "Фокусна кључна фраза чланка или null ако није постављена."

#. translators: %1$s expands to <p>, %2$s expands to </p>, %3$s expands to <p>,
#. %4$s expands to </p>, %5$s expands to <strong>, %6$s expands to </strong>,
