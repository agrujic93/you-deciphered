u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043f\u0440\u0438 \u043f\u0440\u0435\u0443\u0441\u043c\u0435\u0440\u0430\u0432\u0430\u045a\u0443 \u043d\u0430 \u0442\u0440\u0430\u0436\u0435\u043d\u0443 \u0432\u0435\u0437\u0443. \u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0458\u0435 \u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0430 \u0438 \u043f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u043f\u043e\u043d\u043e\u0432\u043e."],"Select if you have been granted tax-exempt status by the Internal Revenue Service (IRS)":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0432\u0430\u043c \u0458\u0435 \u041f\u043e\u0440\u0435\u0441\u043a\u0430 \u0443\u043f\u0440\u0430\u0432\u0430 (\u0418\u0420\u0421) \u043e\u0434\u043e\u0431\u0440\u0438\u043b\u0430 \u0441\u0442\u0430\u0442\u0443\u0441 \u043e\u0441\u043b\u043e\u0431\u043e\u0452\u0435\u045a\u0430 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430"],"Select if your business is classed as a government entity":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0458\u0435 \u0432\u0430\u0448\u0435 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0435 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u043a\u0430\u043e \u0434\u0440\u0436\u0430\u0432\u043d\u0438 \u043e\u0440\u0433\u0430\u043d"],"Select if you run a non-business entity":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0432\u043e\u0434\u0438\u0442\u0435 \u043d\u0435\u043f\u043e\u0441\u043b\u043e\u0432\u043d\u0438 \u0441\u0443\u0431\u0458\u0435\u043a\u0442"],"Select if you filed documentation to register your business with a government agency":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0441\u0442\u0435 \u043f\u043e\u0434\u043d\u0435\u043b\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0458\u0443 \u0437\u0430 \u0440\u0435\u0433\u0438\u