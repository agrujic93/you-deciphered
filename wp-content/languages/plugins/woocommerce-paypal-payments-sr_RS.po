msgstr "Укупан износ поруџбине се променио. Поново учитајте страницу и покушајте поново."

#: modules/ppcp-compat/src/WooCommerceBlueprint/PayPalSettingsExporter.php:123
msgid "Exports PayPal Payments settings and configuration options, without any connection credentials."
msgstr "Извози PayPal Payments подешавања и могућности, без икаквих података за повезивање."

#: modules/ppcp-compat/src/WooCommerceBlueprint/PayPalSettingsExporter.php:123
msgid "Exports PayPal Payments settings together with the connection credentials of the connected account. The file will contain your client ID and client secret in plain text, so store it securely and do not share it."
msgstr "Извози PayPal Payments подешавања заједно са подацима за повезивање повезаног налога. Датотека ће садржати ваш ИБ клијента и тајну клијента као обичан текст, па је чувајте безбедно и не делите је."

#: modules/ppcp-compat/src/WooCommerceBlueprint/PayPalSettingsExporter.php:110
msgid "PayPal Settings (including connection details)"
msgstr "PayPal подешавања (укључујући детаље повезивања)"

#: modules/ppcp-card-fields/src/CardFieldsModule.php:170
msgid "This payment could not be processed. Please try a different payment method."
msgstr "Ово плаћање није могло да се обради. Покушајте другим начином плаћања."

#: modules/ppcp-card-fields/src/CardFieldsModule.php:166
#: assets/ppcp-sdk-v6-js-boot-add-payment-method.js:1
#: assets/ppcp-sdk-v6-js-boot.js:1 assets/ppcp-sdk-v6-js-checkout-block.js:1
msgid "This card could not be authorized. Please try a different payment method."
msgstr "Ова картица није могла да се одобри. Покушајте другим начином плаћања."

#: modules/ppcp-card-fields/src/CardFieldsModule.php:168
msgid "The 3D Secure validation could not be completed. Please try again or use another card."
msgstr "3D Secure провера није могла да се доврши. Покушајте поново или користите другу картицу."

#: modules/ppcp-settings/src/Data/Definition/PaymentMethodsDefinition.php:171
msgid "A PayPal-powered checkout option letting customers pay with cryptocurrency. You receive funds in USD, settled directly to your PayPal balance — no crypto exposure, no chargeback risk."
msgstr "Могућност плаћања коју покреће PayPal и која купцима омогућава плаћање криптовалутом. Средства примате у USD, поравната директно на ваше PayPal стање — без изложености криптовалутама и без ризика од повраћаја средстава."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "the transaction could not be completed."
msgstr "трансакција није могла да се доврши."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your bank declined this transaction."
msgstr "ваша банка је одбила ову трансакцију."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your bank is temporarily unavailable."
msgstr "ваша банка је привремено недоступна."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your bank was unable to approve this transaction."
msgstr "ваша банка није могла да одобри ову трансакцију."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your card is currently blocked."
msgstr "ваша картица је тренутно блокирана."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your card is no longer active."
msgstr "ваша картица више није активна."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your bank flagged this payment for manual review."
msgstr "ваша банка је означила ово плаћање за ручни преглед."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "a similar transaction was already submitted recently."
msgstr "слична трансакција је недавно већ послата."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "the additional card verification could not be completed."
msgstr "додатна провера картице није могла да се доврши."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "the card details could not be verified."
msgstr "подаци о картици нису могли да се провере."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "the PIN entered is incorrect."
msgstr "унети PIN није тачан."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "the card's security code could not be verified."
msgstr "сигурносни кôд картице није могао да се провери."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your card has not been activated."
msgstr "ваша картица није укључена."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your card has expired."
msgstr "ваша картица је истекла."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:209
msgid "your card was declined due to insufficient funds."
msgstr "ваша картица је одбијена због недовољно средстава."

#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:208
msgid "your card was declined by your bank."
msgstr "ваша банка је одбила вашу картицу."

#. translators: %s - a plain-language reason the payment was declined.
#: modules/ppcp-api-client/src/Entity/FraudProcessorResponse.php:181
msgid "Your payment could not be processed because %s Please try a different payment method or contact your bank for more information."
msgstr "Ваше плаћање није могло да се обради јер %s Покушајте другим начином плаћања или се обратите својој банци за више података."

#: modules/ppcp-wc-subscriptions/src/Endpoint/SubscriptionChangePaymentMethod.php:68
msgid "You do not have permission to use this payment token."
msgstr "Немате дозволу да користите овај жетон плаћања."

