#: modules/ppcp-settings/src/Endpoint/SettingsRestEndpoint.php:85
msgid "The invoice prefix may only contain letters, numbers, hyphens and underscores."
msgstr "Префикс рачуна може садржати само слова, бројеве, цртице и доње црте."

#. translators: 1: amount the shopper saved, 2: total shown in the wallet
#. payment sheet, 3: total charged
#: modules/ppcp-sdk-v6/src/Helper/RecordedQuote.php:76
msgid "You saved %1$s. We estimated %2$s at checkout, but the tax for your billing address is lower, so your actual charge is %3$s."
msgstr "Уштедели сте %1$s. Проценили смо %2$s при плаћању, али је порез за вашу адресу за наплату мањи, па је ваше стварно задужење %3$s."

#. translators: 1: total shown in the wallet payment sheet, 2: total of this
#. order
#: modules/ppcp-sdk-v6/src/Helper/RecordedQuote.php:49
msgid "The wallet payment sheet showed %1$s and this order totals %2$s. The sheet estimated tax from the shipping address; the final amount uses the card's billing address."
msgstr "Лист плаћања новчаником приказао је %1$s, а ова поруџбина износи укупно %2$s. Лист је проценио порез на основу адресе за доставу; коначни износ користи адресу за наплату картице."

#: modules/ppcp-sdk-v6/src/Helper/GooglePayConfig.php:46
msgid "Google Pay availability cannot be determined before the wp_loaded action has run."
msgstr "Доступност Google Pay не може да се утврди пре покретања радње wp_loaded."

#: modules/ppcp-sdk-v6/src/Helper/FastlaneConfig.php:57
