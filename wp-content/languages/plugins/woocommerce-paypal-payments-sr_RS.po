msgstr "Доступност Fastlane не може да се утврди пре покретања радње wp_loaded."

#: modules/ppcp-sdk-v6/src/Helper/ApplePayConfig.php:45
msgid "Apple Pay availability cannot be determined before the wp_loaded action has run."
msgstr "Доступност Apple Pay не може да се утврди пре покретања радње wp_loaded."

#: modules/ppcp-sdk-v6/src/Assets/SdkV6Manager.php:954
msgid "Tax"
msgstr "Порез"

#. translators: 1: country the tax was recalculated for, 2: the corrected total
#: modules/ppcp-sdk-v6/src/Endpoint/CartQuoteEndpoint.php:123
msgid "Nothing has been charged yet. Tax for %1$s differs from our estimate, so your total is now %2$s. Please try again."
msgstr "Још ништа није наплаћено. Порез за %1$s разликује се од наше процене, па је ваш укупни износ сада %2$s. Покушајте поново."

#: modules/ppcp-sdk-v6/src/Assets/SdkV6Manager.php:952
msgid "Subtotal"
msgstr "Укупно"

#: modules/ppcp-sdk-v6/src/Assets/SdkV6Manager.php:953
msgid "Shipping"
msgstr "Достава"

#: modules/ppcp-sdk-v6/src/Assets/SdkV6Manager.php:950
