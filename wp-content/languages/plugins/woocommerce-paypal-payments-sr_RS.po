#: modules/ppcp-abilities/src/Domain/GetPaypalOrder.php:141
msgid "Either paypal_order_id or wc_order_id is required."
msgstr "Потребан је paypal_order_id или wc_order_id."

#: modules/ppcp-abilities/src/Domain/GetPaypalOrder.php:136
msgid "paypal_order_id must be an alphanumeric uppercase PayPal order ID (1-64 chars)."
msgstr "paypal_order_id мора бити алфанумерички PayPal ИБ поруџбине великим словима (1-64 знака)."

#: modules/ppcp-abilities/src/Domain/GetPaypalOrder.php:85
