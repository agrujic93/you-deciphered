ister your business with a government agency":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0441\u0442\u0435 \u043f\u043e\u0434\u043d\u0435\u043b\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0458\u0443 \u0437\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0458\u0443 \u0441\u0432\u043e\u0433 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430 \u043a\u043e\u0434 \u0434\u0440\u0436\u0430\u0432\u043d\u0435 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0435"],"Select if you run your own business as an individual and are self-employed":["\u0418\u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0430 \u043b\u0438 \u0432\u043e\u0434\u0438\u0442\u0435 \u0441\u043e\u043f\u0441\u0442\u0432\u0435\u043d\u0438 \u043f\u043e\u0441\u0430\u043e \u043a\u0430\u043e \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430\u0446 \u0438 \u0441\u0430\u043c\u043e\u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0438 \u0441\u0442\u0435"],"No selection":["\u041d\u0435\u043c\u0430 \u0438\u0437\u0431\u043e\u0440\u0430"],"Currently selected: %s":["\u0422\u0440\u0435\u043d\u0443\u0442\u043d\u043e \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u043e: %s"],"Continue":["\u041d\u0430\u0441\u0442\u0430\u0432\u0438"],"Cancel":["\u041e\u0434\u0443\u0441\u0442\u0430\u043d\u0438"],"Back":["\u041d\u0430\u0437\u0430\u0434"],"Learn more":["\u0421\u0430\u0437\u043d\u0430\u0458 \u0432\u0438\u0448\u0435"]}},"comment":{"reference":"dist\/chunks\/wcpay-onboarding.js"}}