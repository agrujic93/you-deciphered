msgid "Your WordPress install has old folders from its state before you restored/migrated (technical information: these are suffixed with -old)."
msgstr "Ваша Вордпрес поставка има старе фасцикле из стања пре враћања/миграције (технички подаци: имају наставак -old)."

#: admin.php:3299
msgid "This plugin may struggle with a memory limit of less than 64 Mb  - especially if you have very large files uploaded (though on the other hand, many sites will be successful with a 32Mb limit - your experience may vary)."
msgstr "Овај додатак може имати проблема са ограничењем меморије мањим од 64 Mb  – нарочито ако имате отпремљене врло велике датотеке (мада, с друге стране, многи сајтови успешно раде и са ограничењем од 32Mb – ваше искуство може бити другачије)."

#: admin.php:3299
msgid "UpdraftPlus attempted to raise it but was unsuccessful."
msgstr "UpdraftPlus је покушао да га повећа, али није успео."

#: admin.php:3299
msgid "Your PHP memory limit (set by your web hosting company) is very low."
msgstr "Ваше PHP ограничење меморије (које је поставио ваш пружалац хостинга) врло је ниско."

#: admin.php:3243
msgid "The UpdraftPlus directory in wp-content/plugins has white-space in it; WordPress does not like this."
msgstr "Директоријум UpdraftPlus у wp-content/plugins има размак у имену; Вордпрес то не воли."

#: admin.php:3132
msgid "We really appreciate your support!"
msgstr "Заиста ценимо вашу подршку!"

#: admin.php:3243
msgid "You should rename the directory to wp-content/plugins/updraftplus to fix this problem."
msgstr "Да бисте решили овај проблем, преименујте директоријум у wp-content/plugins/updraftplus."

#: admin.php:2990
msgid "Perhaps you need to install an add-on?"
msgstr "Можда треба да поставите проширење?"

#. translators: %s: Object type
#: admin.php:2987
msgid "This looks like a file created by UpdraftPlus, but this install does not know about this type of object: %s."
msgstr "Ово изгледа као датотека коју је направио UpdraftPlus, али ова поставка не познаје ову врсту објекта: %s."

#: admin.php:2671
msgid "Aborting this backup."
msgstr "Прекида се ово прављење резервне копије."

#: admin.php:1867
msgid "Therefore, please download the attachment from the original backup email and upload it using the \"Upload backup files\" facility in the \"Existing Backups\" tab."
msgstr "Зато преузмите прилог из првобитне е-поруке са резервном копијом и отпремите га помоћу могућности „Отпреми датотеке резервних копија“ на језичку „Постојеће резервне копије“."

#: admin.php:2664 includes/class-commands.php:1048
msgid "OK."
msgstr "У реду."

#: admin.php:1867
msgid "The email protocol does not allow a remote backup to be retrieved from an email that has been sent."
msgstr "Протокол е-поште не дозвољава преузимање удаљене резервне копије из послате е-поруке."

