msgid "Failed to set the connection charset to a compatible UTF8 character set; aborting"
msgstr "Постављање скупа знакова везе на усклађени UTF8 скуп знакова није успело; радња се прекида"

#. translators: %s: Character sets
#: class-updraftplus.php:5551
msgid "If you wish to restore it, then you must set the constant UPDRAFTPLUS_ALLOW_ANY_SET_NAMES and then try again; this should only be done if the backup was created by a third-party tool which you know handles encoding correctly, to avoid corruption."
msgstr "Ако желите да је вратите, поставите константу UPDRAFTPLUS_ALLOW_ANY_SET_NAMES и покушајте поново — то урадите само ако је резервну копију направила спољна алатка за коју поуздано знате да исправно обрађује кодирање, како бисте избегли оштећење података."

#: templates/wp-admin/settings/form-contents.php:143
msgid "Only leave the storage selection blank if you intend to manually copy the files to your computer."
msgstr "Оставите избор складишта празним само ако намеравате да ручно копирате датотеке на свој рачунар."

#: templates/wp-admin/settings/form-contents.php:143
msgid "We recommend choosing at least one storage option, but multiple is the ideal."
msgstr "Препоручујемо избор бар једне могућности складиштења, а више локација је идеално."

#: templates/wp-admin/settings/form-contents.php:143
msgid "If you don't select storage, your backups will be saved to your web-server (please don't do this - if the server ever goes down, you lose it all)."
msgstr "Ако не одаберете складиште, ваше резервне копије биће сачуване на вашем веб серверу (немојте то радити — ако сервер икада откаже, изгубићете све)."

#. translators: %s: 'UpdraftPlus Premium' link
#: templates/wp-admin/settings/form-contents.php:131
msgid "You can also save your backups to multiple locations for added assurance, only with %s."
msgstr "Такође можете да чувате своје резервне копије на више локација ради додатне сигурности, само уз %s."

#. translators: %s: 'UpdraftPlus Premium' link
#: templates/wp-admin/settings/form-contents.php:117
msgid "Unlock even more storage options with %s."
msgstr "Откључајте још више могућности складиштења уз %s."

#. translators: %s: String 'UpdraftPlus'
#: templates/wp-admin/settings/form-contents.php:98
msgid "integrated with %s"
msgstr "интегрисано са %s"

#: templates/wp-admin/settings/form-contents.php:84
msgid "Select your remote storage location"
msgstr "Одаберите своју удаљену локацију за складиштење"

#. translators: %s: Filename (wp-config.php)
#: templates/wp-admin/settings/delete-and-restore-modals.php:90
msgid "To restore this site, temporarily remove or set this constant to false in %s, perform the restore, then re-enable the constant."
msgstr "Да бисте вратили овај сајт, привремено уклоните ову константу или је поставите на false у датотеци %s, извршите враћање, па поново укључите константу."

#: templates/wp-admin/settings/delete-and-restore-modals.php:81
msgid "All restore operations (including database) are disabled."
msgstr "Све операције враћања (укључујући базу података) су онемогућене."

#. translators: %s: DISALLOW_FILE_MODS constant name, wrapped in a <code> tag
#: templates/wp-admin/settings/delete-and-restore-modals.php:79
msgid "The %s constant is currently active on this site."
msgstr "Константа %s је тренутно активна на овом сајту."

#: templates/wp-admin/settings/delete-and-restore-modals.php:74
msgid "Restore operations are disabled"
msgstr "Операције враћања су онемогућене"

#: restorer.php:674
msgid "To restore this site, temporarily remove the constant from wp-config.php or set it to false."
msgstr "Да бисте вратили овај сајт, привремено уклоните константу из датотеке wp-config.php или је поставите на false."

#. translators: %s: Constant name (DISALLOW_FILE_MODS)
#: restorer.php:672
msgid "Restore operations are disabled by the %s constant."
msgstr "Операције враћања су онемогућене константом %s."

#: includes/updraftplus-migration.php:557
msgid "The migration is now in progress — updates will appear below shortly."
msgstr "Миграција је сада у току — обавештења о напретку појавиће се ускоро испод."

#: includes/updraftplus-migration.php:554
msgid "Migration in progress"
msgstr "Миграција је у току"

#: includes/updraftplus-migration.php:549
msgid "Note: if you're asked to log in to the destination site, use this site's credentials, not the destination site's original login details."
msgstr "Напомена: ако се од вас затражи да се пријавите на одредишни сајт, користите приступне податке овог сајта, а не изворне податке за пријаву на одредишни сајт."

#: includes/updraftplus-migration.php:548
msgid "Once it's complete, the destination site may ask you to update the WordPress database or to log in again."
msgstr "Када се заврши, одредишни сајт може затражити да ажурирате Вордпресову базу података или да се поново пријавите."

#: includes/updraftplus-migration.php:546
msgid "Note: if you're asked to log in, use the credentials from the imported site, not this site's original login details."
msgstr "Напомена: ако се од вас затражи да се пријавите, користите приступне податке са увезеног сајта, а не изворне податке за пријаву на овај сајт."

#: includes/updraftplus-migration.php:545
msgid "Once it's complete, you may be asked to update the WordPress database or to log in again."
msgstr "Када се заврши, можда ће се од вас затражити да ажурирате Вордпресову базу података или да се поново пријавите."

