{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "simple-block/hero-advanced",
	"title": "Hero Advanced",
	"description": "An advanced hero block with GSAP text animations and MP4 video support.",
	"category": "custom-blocks",
	"icon": "welcome-view-site",
	"keywords": [ "hero", "advanced", "video", "gsap" ],
	"supports" : {
		"spacing": {
			"margin": true,
			"padding": true
		},
		"anchor": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "hero-advanced-block.php",
		"blockVersion": 3,
		"hideFieldsInSidebar": true
	},
	"align": "full",
	"viewScript": [
		"file:./hero-advanced-block.js",
		"hero-advanced-js"
	],
	"viewStyle": "file:./hero-advanced-block.css"
}
