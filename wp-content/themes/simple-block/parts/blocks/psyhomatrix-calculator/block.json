{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "simple-block/psyhomatrix-calculator",
    "title": "Psyhomatrix Calculator",
    "description": "Pythagorean Psychomatrix calculator block with bilingual (EN/SR) Polylang support, ACF overrides, QR sharing, and image download.",
    "style": [
        "file:./psyhomatrix-calculator.css"
    ],
    "viewScript": [
        "qrcodejs",
        "psyhomatrix-calculator-js"
    ],
    "category": "custom-blocks",
    "icon": "calculator",
    "keywords": [
        "psyhomatrix",
        "psychomatrix",
        "numerology",
        "calculator"
    ],
    "supports": {
        "align": [
            "full",
            "wide"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "anchor": true
    },
    "acf": {
        "mode": "auto",
        "renderTemplate": "psyhomatrix-calculator.php",
        "blockVersion": 3,
        "hideFieldsInSidebar": true
    },
    "align": "full"
}
